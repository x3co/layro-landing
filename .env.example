# Public scheduling link for the "Agendar llamada" button.
# Cal.com, Calendly, or any https URL. Leave empty to show a disabled button.
NEXT_PUBLIC_CALENDAR_URL=

# Optional address shown on the privacy page for access and deletion requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Storage option A — Postgres. When set, this is the only store used.
# The API creates the briefs table on first write. The SQL is also in db/schema.sql.
# Example (Neon, Supabase, RDS): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# Storage option B — Resend. Used only when DATABASE_URL is empty.
# All three variables are required. RESEND_FROM_EMAIL must be a verified sender.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
BRIEF_NOTIFY_EMAIL=
